<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<StaticWebAssetBasePath>/</StaticWebAssetBasePath>
		<RootNamespace>uSync.AI.Sync</RootNamespace>

		<ContentTargetFolders>content</ContentTargetFolders>

		<PackageId>uSync.AI.Sync</PackageId>
		<Product>uSync.AI.Sync</Product>
		<Title>uSync for Umbraco.AI - settings</Title>
		<Description>uSync handlers and serializers for Umbraco.AI connections, profiles, contexts, guardrails and settings.</Description>
		<PackageTags>umbraco usync ai umbraco-marketplace</PackageTags>

		<PackageReadmeFile>readme.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="readme.md" Pack="true" PackagePath="\" />

		<PackageReference Include="Umbraco.Cms.Web.Website" />
		<PackageReference Include="Umbraco.Cms.Api.Management" />

		<!-- Startup, not just Core: it is what registers the IAI*Service implementations the
		     handlers depend on, so this package cannot be installed without a working Umbraco.AI. -->
		<PackageReference Include="Umbraco.AI.Startup" />

		<PackageReference Include="uSync.BackOffice" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="uSync.AI.Tests" />
		<InternalsVisibleTo Include="uSync.AI.Prompt" />
		<InternalsVisibleTo Include="uSync.AI.Agent" />
	</ItemGroup>

	<!-- Client build, as uSync.Automate: a clean clone always produces a bundle at build time -->
	<!-- instead of relying on a committed wwwroot. -->
	<ItemGroup>
		<ClientAssetsInputs Include="ai-client\**" Exclude="$(DefaultItemExcludes)" />
		<Content Remove="ai-client\**" />
	</ItemGroup>

	<Target Name="RestoreClient" Inputs="ai-client\package.json;ai-client\package-lock.json"
			Outputs="ai-client\node_modules\.package-lock.json">
		<Message Importance="high" Text="Restoring uSync.AI.Sync client NPM packages..." />
		<Exec Command="npm ci" WorkingDirectory="ai-client" />
	</Target>

	<Target Name="BuildClient" BeforeTargets="AssignTargetPaths" DependsOnTargets="RestoreClient"
			Inputs="@(ClientAssetsInputs)" Outputs="$(IntermediateOutputPath)client.complete.txt">
		<Message Importance="high" Text="Executing uSync.AI.Sync client NPM build script..." />
		<Exec Command="npm run build" WorkingDirectory="ai-client" />
		<ItemGroup>
			<_ClientAssetsBuildOutput Include="wwwroot\App_Plugins\**" />
		</ItemGroup>
		<WriteLinesToFile File="$(IntermediateOutputPath)client.complete.txt" Lines="@(_ClientAssetsBuildOutput)" Overwrite="true" />
	</Target>

</Project>
