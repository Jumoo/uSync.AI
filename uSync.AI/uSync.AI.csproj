<Project Sdk="Microsoft.NET.Sdk">
	<!-- Meta package: no assembly of its own, only dependencies on the packages below. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<IncludeSymbols>false</IncludeSymbols>
		<SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
		<NoWarn>$(NoWarn);NU5128</NoWarn>

		<PackageId>uSync.AI</PackageId>
		<Product>uSync.AI</Product>
		<Title>uSync.AI</Title>
		<Description>uSync for Umbraco.AI. Installs settings, prompt and agent sync plus the uSync agent tools.</Description>
		<PackageTags>umbraco usync ai umbraco-marketplace</PackageTags>

		<PackageReadmeFile>readme.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="readme.md" Pack="true" PackagePath="\" />
		<ProjectReference Include="../uSync.AI.Sync/uSync.AI.Sync.csproj" />
		<ProjectReference Include="../uSync.AI.Prompt/uSync.AI.Prompt.csproj" />
		<ProjectReference Include="../uSync.AI.Agent/uSync.AI.Agent.csproj" />
		<ProjectReference Include="../uSync.AI.Tools/uSync.AI.Tools.csproj" />
	</ItemGroup>
</Project>
